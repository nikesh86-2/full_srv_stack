# =========================================
# Nginx Proxy Manager
# =========================================

# ---------------------------------
# Ports
# ---------------------------------
NPM_HTTP_PORT=80       # HTTP traffic
NPM_ADMIN_PORT=81      # Admin web interface
NPM_HTTPS_PORT=443     # HTTPS traffic

# ---------------------------------
# Docker User
# ---------------------------------
PUID=1000              # User ID for Nginx Proxy Manager
PGID=1000              # Group ID for Nginx Proxy Manager

# ---------------------------------
# Database
# ---------------------------------
DB_SQLITE_FILE=/data/database.sqlite

# ---------------------------------
# Volumes (relative paths)
# ---------------------------------
NPM_DATA_PATH=./data
NPM_LETSENCRYPT_PATH=./letsencrypt
