# =========================================
# DDNS Updater
# =========================================
# Reference: https://github.com/qmcgaw/ddns-updater

# ---------------------------------
# Update Settings
# ---------------------------------
PERIOD=5m             # How often to check and update DNS records
LOG_LEVEL=info        # Logging level (debug, info, warn, error)

# ---------------------------------
# Web UI Settings
# ---------------------------------
# The web UI is exposed on port 8000
# No authentication is configured by default
# See documentation for adding authentication

# ---------------------------------
# DNS Provider Configuration
# ---------------------------------
# Create a .env file with your provider credentials
# Example providers: Cloudflare, DuckDNS, Namecheap, etc.
# See: https://ddns-updater.qmcgaw.dev/guides/providers/

# Example Cloudflare credentials (uncomment and fill):
# CLOUDFLARE_API_KEY=your_cloudflare_api_key
# CLOUDFLARE_EMAIL=your_email@example.com

# Example DuckDNS token (uncomment and fill):
# DUCKDNS_TOKEN=your_duckdns_token
